{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "dashboard/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/ingest",
      "dest": "api/index.py"
    },
    {
      "src": "/events/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/events",
      "dest": "api/index.py"
    },
    {
      "src": "/stats/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/stats",
      "dest": "api/index.py"
    },
    {
      "src": "/report/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/report",
      "dest": "api/index.py"
    },
    {
      "src": "/sites/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/sites",
      "dest": "api/index.py"
    },
    {
      "src": "/leads",
      "dest": "api/index.py"
    },
    {
      "src": "/llms.txt",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "dashboard/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dashboard/dist/$1"
    }
  ]
}
