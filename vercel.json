{
  "buildCommand": "cd dashboard && npm install && npm run build",
  "outputDirectory": "dashboard/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/ingest",
      "destination": "/api/index.py"
    },
    {
      "source": "/events/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/events",
      "destination": "/api/index.py"
    },
    {
      "source": "/stats/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/stats",
      "destination": "/api/index.py"
    },
    {
      "source": "/report/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/report",
      "destination": "/api/index.py"
    },
    {
      "source": "/sites/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/sites",
      "destination": "/api/index.py"
    },
    {
      "source": "/leads",
      "destination": "/api/index.py"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
