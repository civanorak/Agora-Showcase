# AGORA Server — environment configuration
# All variables use the AGORA_ prefix (pydantic-settings env_prefix).
# Copy to `.env` and fill in real values. Never commit the real .env.

# --- Storage ---
# Dev/demo uses SQLite (default below). Postgres is the production target (D002).
AGORA_SQLITE_PATH=agora.db
AGORA_DATABASE_URL=postgresql://agora:agora@localhost:5432/agora

# --- Security ---
# Salt for IP hashing (D006). MUST be changed to a long random value in production.
AGORA_API_KEY_HASH_SALT=change-me-in-production

# Bearer token that gates admin/read endpoints: /leads, /sites, and — when demo
# mode is OFF — /events, /events/stream, /stats (D008).
# Empty ⇒ those endpoints are disabled (404). Set a long random value before hosting.
AGORA_ADMIN_TOKEN=

# --- Demo mode ---
# 1 = enable the demo-key bypass, demo signatures, and open read endpoints.
# demo.bat sets this automatically. MUST stay unset/0 in production.
AGORA_DEMO_MODE=0

# --- Web ---
# JSON array of allowed CORS origins (must match your dashboard host).
AGORA_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
AGORA_LOG_LEVEL=INFO
